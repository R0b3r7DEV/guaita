# Mapeo de campos del fichero EFFIS/GWIS de perímetros -> incendio_historico.
#
# AJUSTAR cuando llegue el fichero. Verifica los nombres REALES con:
#   ogrinfo -so -al /data/incendios.<gpkg|shp>
# y corrige las variables de abajo. El loader (load_incendios.sh) NO adivina:
# lee estas variables y falla si una columna no existe en el fichero.
#
# Nombre de la capa dentro del fichero (para shapefile suele ser el basename;
# para GeoPackage el nombre de la tabla). Vacío = primera capa.
INCENDIOS_LAYER=""

# --- Columnas de origen (nombres tal cual vienen en el fichero) --------------
# Los valores DE ABAJO son los típicos de los productos EFFIS/GWIS Burnt Area /
# Final Fire Perimeters; confírmalos con ogrinfo antes de cargar.
FLD_EXT_ID="id"            # identificador del incendio en el producto
FLD_FECHA_INICIO="initialdate"  # fecha de inicio (a veces 'firedate' / 'FIREDATE')
FLD_FECHA_FIN="finaldate"       # fecha final (puede no existir -> deja "")
FLD_SUPERFICIE_HA="area_ha"     # superficie quemada en hectáreas
FLD_NOMBRE="place_name"         # topónimo si lo trae (puede no existir -> deja "")

# --- Filtro opcional de país/ámbito ------------------------------------------
# El recorte real es espacial (contra mv_provincia_continental + 5 km) en el
# loader; esto solo PRE-filtra para no cargar el planeta entero al staging.
# Deja "" si el fichero ya viene acotado a España/Castellón.
FLD_PAIS=""               # p.ej. 'country' -> se filtraría country='ES'
PAIS_VALOR=""             # p.ej. 'ES' o 'Spain'

# --- Unidad de la superficie -------------------------------------------------
# Factor para pasar FLD_SUPERFICIE_HA a hectáreas. 1 si ya viene en ha;
# 0.0001 si viniera en m2. El loader asevera que Bejís queda ~19.000 ha: si el
# factor está mal, salta por diferencia de orden de magnitud.
SUPERFICIE_A_HA="1"
