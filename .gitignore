# --- Secretos: NUNCA versionar (regla cero, docs/07-seguridad.md) ---
.env
.env.local
.env.*.local
*.local.env

# --- Datos descargados (pueden pesar GB, docs/02) ---
/data/*
!/data/.gitkeep

# --- Java / Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
out/
bin/

# --- Python (ETL) ---
__pycache__/
*.pyc

# --- Node / Vite ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# --- Informes generados (docs/09) ---
/reports/

# --- Inventarios generados por el ETL (el CI los sube como artefacto) ---
etl/reports/*
!etl/reports/.gitkeep
# La tabla de descarga del MDT25 es un doc deliberado (lista de la compra), sí se versiona
!etl/reports/mdt25-descarga.md

# --- IDE / editor ---
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Logs locales ---
*.log
