# GUAITA — variables de entorno. Copiar a .env y rellenar.
# El archivo .env real NUNCA se versiona (ver .gitignore y docs/07-seguridad.md).
# Regla cero: ninguna de estas claves llega jamás al frontend.

# --- Base de datos (contenedor db: postgis/postgis:16-3.4) ---
POSTGRES_DB=guaita
POSTGRES_USER=guaita
POSTGRES_PASSWORD=cambia-esto-en-tu-.env-local
# El servicio api resuelve el host/puerto de la BD por estas variables.
DB_HOST=db
DB_PORT=5432

# --- Claves de fuentes externas (SOLO backend) ---
# NASA FIRMS: MAP_KEY gratuito en el portal de FIRMS (docs/02 §1).
FIRMS_MAP_KEY=
# AEMET OpenData: API key gratuita por formulario (docs/02 §2).
AEMET_API_KEY=

# --- Seguridad ---
# Secreto de firma JWT. Mínimo 32 bytes aleatorios. NO reutilizar entre entornos.
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes
