# GUAITA — variables de entorno. Copiar a .env y rellenar.
# El archivo .env real NUNCA se versiona (ver .gitignore y docs/07-seguridad.md).
# Regla cero: ninguna de estas claves llega jamás al frontend.

# --- Base de datos (contenedor db: postgis/postgis:16-3.4) ---
POSTGRES_DB=guaita
POSTGRES_USER=guaita
POSTGRES_PASSWORD=cambia-esto-en-tu-.env-local
# El servicio api resuelve el host/puerto de la BD por estas variables.
DB_HOST=db
DB_PORT=5432

# --- Claves de fuentes externas (SOLO backend) ---
# NASA FIRMS: MAP_KEY gratuito en el portal de FIRMS (docs/02 §1).
FIRMS_MAP_KEY=
# AEMET OpenData: API key gratuita por formulario (docs/02 §2).
AEMET_API_KEY=

# --- Seguridad ---
# Secreto de firma JWT. Mínimo 32 bytes aleatorios. NO reutilizar entre entornos.
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes

# --- Despliegue en VPS (SOLO con docker-compose.vps.yml; todas opcionales) ---
# Puertos del host, por si XPL0DAY ya ocupa 5432/8080/5173. El puerto INTERNO no cambia.
# DB_PORT_HOST=5433
# API_PORT_HOST=8081
# WEB_PORT_HOST=5174
# Límites de recursos (dejar aire a producción). Ajustar tras ver `free -h`/`docker stats`.
# DB_MEM_LIMIT=1g
# DB_CPUS=1.0
# API_MEM_LIMIT=1g
# API_CPUS=1.0
# Heap del backfill (-Xmx). Mantener ~350 MB por debajo de API_MEM_LIMIT (no-heap).
# API_XMX=640m
# WEB_MEM_LIMIT=256m
# WEB_CPUS=0.5
# Rotación de logs de Docker (evita que llenen el disco).
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
# Guardia de disco del backfill. Ruta del HOST a vigilar (donde vive el volumen de PG);
# la raíz por defecto, o la partición de Docker si está separada. Umbral en GB.
# DISK_GUARD_HOST_PATH=/
# DISK_MIN_FREE_GB=5
# Job diario de meteo+FWI (operación). Actívalo SOLO tras completar el backfill histórico
# (si no, generaría cadenas parciales). Requiere reiniciar la api. Dispara a las 06:30 Europe/Madrid.
# GUAITA_SCHEDULER_ENABLED=true
